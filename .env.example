# Copy this file to .env and fill in your own values.

PORT=5000
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
DB_PATH=./database.sqlite
ADMIN_EMAIL=admin@iqintern.in
ADMIN_PASSWORD=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# --- Razorpay payment gateway ---
# Dashboard: https://dashboard.razorpay.com -> Settings -> API Keys
# Test keys (rzp_test_...) for testing, live keys (rzp_live_...) for production.
# Leave empty to run in DEMO mode (simulated checkout, development only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shared secret for https://your-domain/api/razorpay/webhook
# (Razorpay Dashboard -> Settings -> Webhooks; events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# --- Supabase registry (optional write-through mirror) ---
# The app stays on SQLite; users/enrollments/payments are mirrored into
# Supabase for centralized validation. Server-side only (service role key
# never reaches the browser). Dashboard -> Settings -> API.
# Leave empty or set SUPABASE_SYNC=false to disable mirroring.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional Postgres connection string (Dashboard -> Database -> Connection
# string -> URI) so scripts/supabase-migrate.js can apply
# scripts/supabase-schema.sql automatically. Otherwise paste that file into
# the SQL Editor once before running the migration.
SUPABASE_DB_URL=

SUPABASE_SYNC=true
