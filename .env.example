# Copy this file to .env and fill in your own values.

PORT=5000
# Public site URL (certificate verification links / QR codes). On Vercel set
# this to https://<your-project>.vercel.app
SITE_URL=http://localhost:5000
# Set to 1 behind a proxy (REQUIRED on Vercel/Render) so rate limiting sees
# real client IPs instead of the proxy's single shared IP.
TRUST_PROXY=1
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@iqintern.in
ADMIN_PASSWORD=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# --- Primary database (REQUIRED) ---
# Supabase Dashboard -> Connect -> Connection string -> URI -> Session pooler.
# Always use the pooler host (IPv4). The direct `db.<ref>.supabase.co` host is
# IPv6-only and fails on hosts without IPv6 (e.g. Render) with
# "Database initialization failed ... network unreachable". Example:
# postgresql://postgres.<ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# --- Razorpay payment gateway ---
# Dashboard: https://dashboard.razorpay.com -> Settings -> API Keys
# Test keys (rzp_test_...) for testing, live keys (rzp_live_...) for production.
# Leave empty to run in DEMO mode (simulated checkout, development only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shared secret for https://your-domain/api/razorpay/webhook
# (Razorpay Dashboard -> Settings -> Webhooks; events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=
